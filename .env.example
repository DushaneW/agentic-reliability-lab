# Agentic Reliability Lab environment variables. Copy to .env (git-ignored).
#
# The scripted reference agent needs none of the API keys below. They are read
# only by `arl benchmark run --agent llm`.

# Path to the local SQLite database used by the dashboard (the CLI takes --db).
ARL_DB_PATH=arl.db

# Where the dashboard reads the reliability metrics file from.
# ARL_METRICS_PATH=models/reliability_metrics.json

# --agent llm --provider anthropic
# ANTHROPIC_API_KEY=

# --agent llm --provider openai-compat (optional: local servers usually need no key)
# OPENAI_API_KEY=
