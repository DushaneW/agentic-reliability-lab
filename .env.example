# Agentic Reliability Lab reads no required environment variables today:
# the reference agent is a deterministic scripted policy (see
# docs/research/limitations.md), not a call to an external model provider,
# so there is no API key to configure.
#
# This file exists as the place an external-agent adapter (e.g. one wrapping
# a real LLM provider) would read its credentials from, and as the anchor for
# ARL_DB_PATH below.

# Path to the local SQLite database used by `arl` commands via --db,
# or as a default if you wire one up in your own scripts.
ARL_DB_PATH=arl.db
